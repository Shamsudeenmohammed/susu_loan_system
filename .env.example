# =============================================================================
# SUSU COLLECTION & LOAN MANAGEMENT SYSTEM - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# Django
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (used in production)
DB_NAME=susu_loan_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Brevo SMS
BREVO_API_KEY=
BREVO_SMS_SENDER=Zemzem savings and loans
BREVO_ENABLED=False
SMS_TEST_MODE=True

# Paystack
PAYSTACK_SECRET_KEY=sk_test_ba7524069226fc239b5d5c4b4bf8636a7d33fe4f
PAYSTACK_PUBLIC_KEY=pk_test_88e8cfcfab1882455cd240374a19150557542a9f
PAYSTACK_WEBHOOK_SECRET=

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@zemzemsavings.com

# Application
SITE_URL=http://localhost:8000
TIME_ZONE=Africa/Accra
ORGANIZATION_NAME=Zemzem Savings and Loans
