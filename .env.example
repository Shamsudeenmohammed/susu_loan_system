# =============================================================================
# SUSU COLLECTION & LOAN MANAGEMENT SYSTEM - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# Django
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (used in production)
DB_NAME=susu_loan_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Sailup SMS
# Transactional SMS via Sailup (https://www.sailup.io/docs)
# Leave SAILUP_API_KEY empty in local development unless you want real test SMS.
SAILUP_API_KEY= "sailup_LLp4_C6R6xCzLDS5Wt1M0rFgs8CKFg__xZr-L3UDCVE"
SAILUP_BASE_URL=https://api.sailup.io/v1
SAILUP_SENDER_ID=ZEMZEM SAVINGS AND LOANS
SAILUP_TIMEOUT=10
SAILUP_ENABLED=False
SMS_TEST_MODE=True

# Paystack
PAYSTACK_SECRET_KEY=sk_test_ba7524069226fc239b5d5c4b4bf8636a7d33fe4f
PAYSTACK_PUBLIC_KEY=pk_test_88e8cfcfab1882455cd240374a19150557542a9f
PAYSTACK_WEBHOOK_SECRET=

